{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mac-arm64-release",
      "displayName": "macOS ARM64 Release",
      "description": "Build using arm64 libraries via vcpkg",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "PERASTAGE_REQUIRE_SECURE_CREDENTIAL_STORE": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "mac-arm64-debug",
      "displayName": "macOS ARM64 Debug",
      "description": "Debug build using arm64 libraries via vcpkg",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "PERASTAGE_REQUIRE_SECURE_CREDENTIAL_STORE": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "wsl-x64-release",
      "displayName": "WSL/Linux x64 Release",
      "description": "WSL/Linux Release build using system packages",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_FIND_USE_PACKAGE_REGISTRY": "OFF",
        "CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY": "OFF",
        "CMAKE_FIND_PACKAGE_PREFER_CONFIG": "OFF",
        "CURL_NO_CURL_CMAKE": "ON",
        "CMAKE_IGNORE_PREFIX_PATH": "/mnt/c;/mnt/c/vcpkg;/mnt/c/vcpkg/installed;/mnt/c/vcpkg/installed/x64-windows",
        "CMAKE_IGNORE_PATH": "/mnt/c;/mnt/c/vcpkg;/mnt/c/vcpkg/installed;/mnt/c/vcpkg/installed/x64-windows",
        "PERASTAGE_REQUIRE_SECURE_CREDENTIAL_STORE": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "wsl-x64-debug",
      "displayName": "WSL/Linux x64 Debug",
      "description": "WSL/Linux Debug build with symbols for GDB",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_FIND_USE_PACKAGE_REGISTRY": "OFF",
        "CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY": "OFF",
        "CMAKE_FIND_PACKAGE_PREFER_CONFIG": "OFF",
        "CURL_NO_CURL_CMAKE": "ON",
        "CMAKE_IGNORE_PREFIX_PATH": "/mnt/c;/mnt/c/vcpkg;/mnt/c/vcpkg/installed;/mnt/c/vcpkg/installed/x64-windows",
        "CMAKE_IGNORE_PATH": "/mnt/c;/mnt/c/vcpkg;/mnt/c/vcpkg/installed;/mnt/c/vcpkg/installed/x64-windows",
        "PERASTAGE_REQUIRE_SECURE_CREDENTIAL_STORE": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "win-x64-release",
      "displayName": "Windows x64 Release (Visual Studio)",
      "description": "Release build using the Visual Studio generator and vcpkg",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PERASTAGE_REQUIRE_SECURE_CREDENTIAL_STORE": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_MANIFEST_MODE": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "win-x64-debug",
      "displayName": "Windows x64 Debug (Visual Studio)",
      "description": "Debug build using the Visual Studio generator and vcpkg",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PERASTAGE_REQUIRE_SECURE_CREDENTIAL_STORE": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_MANIFEST_MODE": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "win-x64-release-ninja",
      "displayName": "Windows x64 Release (Ninja)",
      "description": "Release build using Ninja, MSVC and vcpkg",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "PERASTAGE_REQUIRE_SECURE_CREDENTIAL_STORE": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_MANIFEST_MODE": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "win-x64-debug-ninja",
      "displayName": "Windows x64 Debug (Ninja)",
      "description": "Debug build using Ninja, MSVC and vcpkg",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "PERASTAGE_REQUIRE_SECURE_CREDENTIAL_STORE": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_MANIFEST_MODE": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-release-stage",
      "displayName": "Stage Windows Release",
      "description": "Builds the Windows release and stages runtime resources for packaging",
      "configurePreset": "win-x64-release",
      "targets": [
        "perastage_stage"
      ],
      "jobs": 8,
      "verbose": false,
      "configuration": "Release"
    },
    {
      "name": "win-debug-build",
      "displayName": "Build Windows Debug",
      "description": "Builds the Windows debug version",
      "configurePreset": "win-x64-debug",
      "jobs": 8,
      "verbose": false,
      "configuration": "Debug"
    },
    {
      "name": "mac-release-build",
      "displayName": "Build macOS ARM64 Release",
      "description": "Builds the macOS ARM64 release",
      "configurePreset": "mac-arm64-release",
      "jobs": 8
    },
    {
      "name": "mac-debug-build",
      "displayName": "Build macOS ARM64 Debug",
      "description": "Builds the macOS ARM64 debug",
      "configurePreset": "mac-arm64-debug",
      "jobs": 8
    },
    {
      "name": "wsl-release-build",
      "displayName": "WSL Release Build",
      "description": "Build Perastage Release in WSL/Linux",
      "configurePreset": "wsl-x64-release",
      "jobs": 8,
      "verbose": false
    },
    {
      "name": "wsl-debug-build",
      "displayName": "WSL Debug Build",
      "description": "Build Perastage Debug in WSL/Linux",
      "configurePreset": "wsl-x64-debug",
      "jobs": 8,
      "verbose": false
    },
    {
      "name": "wsl-release-stage",
      "displayName": "WSL Release Stage",
      "description": "Build and stage runtime files into out/install in WSL/Linux",
      "configurePreset": "wsl-x64-release",
      "targets": [
        "perastage_stage"
      ],
      "jobs": 8,
      "verbose": false
    },
    {
      "name": "win-release-build-ninja",
      "displayName": "Build Windows Release (Ninja)",
      "description": "Builds the Windows release with Ninja",
      "configurePreset": "win-x64-release-ninja",
      "jobs": 8
    },
    {
      "name": "win-debug-build-ninja",
      "displayName": "Build Windows Debug (Ninja)",
      "description": "Builds the Windows debug with Ninja",
      "configurePreset": "win-x64-debug-ninja",
      "jobs": 8
    }
  ]
}
