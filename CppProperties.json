{
  "configurations": [
    {
      "name": "x64-Debug",
      "inheritEnvironments": [
        "msvc_x64_x64"
      ],
      "includePath": [
        "C:/vcpkg/installed/x64-windows/include",
        "${env.INCLUDE}",
        "${workspaceRoot}\\**"
      ],
      "defines": [
        "WIN32",
        "_DEBUG",
        "UNICODE",
        "_UNICODE"
      ],
      "intelliSenseMode": "windows-msvc-x64",
      "cppStandard": "c++20",
      "compileCommands": "${workspaceRoot}\\build\\win-x64-debug-ninja\\compile_commands.json"
    }
  ]
}
